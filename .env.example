# Copy this file to .env and fill in what you need.

# AI reading of receipts, work schedules and pay stubs. Set ONE of these; without either
# the app uses on-device OCR (Tesseract) and keyword rules.

# NVIDIA (free key at https://build.nvidia.com/) — used first when set
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,meta/llama-3.2-11b-vision-instruct   # tried in order

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high
# PORT=3000
# HOST=127.0.0.1                 # use 0.0.0.0 to open from your phone on the same Wi-Fi (no login — trusted networks only)
# DATA_DIR=data
